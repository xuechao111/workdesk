{
  "manifest_version": 3,
  "name": "编程猫副本工作台连接器",
  "version": "1.6.77",
  "description": "副本8766专用；手动更新；不访问主工作台8765。",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*",
    "https://codecamp-crm.codemao.cn/*",
    "https://lbk-crm-teacher-web-api.codemao.cn/*",
    "https://api-codecamp-crm.codemao.cn/*",
    "https://cloud-gateway.codemao.cn/*",
    "https://mcp-gw.dingtalk.com/*",
    "https://bigdata-superset.codemao.cn/*",
    "https://codecamp-marketing.codemao.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8766/*",
        "http://localhost:8766/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
