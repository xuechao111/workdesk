{
  "manifest_version": 3,
  "name": "编程猫教学控制台连接器",
  "version": "1.6.79",
  "description": "主工作台8765专用；不访问副本8766。",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://codecamp-crm.codemao.cn/*",
    "https://lbk-crm-teacher-web-api.codemao.cn/*",
    "https://api-codecamp-crm.codemao.cn/*",
    "https://cloud-gateway.codemao.cn/*",
    "https://mcp-gw.dingtalk.com/*",
    "https://bigdata-superset.codemao.cn/*",
    "https://codecamp-marketing.codemao.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
